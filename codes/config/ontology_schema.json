{
  "version": "1.0",
  "name": "valve-factory-ontology",
  "label": "阀门工厂本体",
  "entities": [
    {
      "id": "Product",
      "label": "产品",
      "table": "valve_products",
      "key": "id",
      "domain": "生产域",
      "attributes": [
        {"name": "id", "type": "string", "label": "编号", "required": true},
        {"name": "product_name", "type": "string", "label": "产品名"},
        {"name": "type", "type": "enum", "label": "类型"},
        {"name": "size_mm", "type": "number", "label": "口径(mm)"},
        {"name": "pressure_mpa", "type": "number", "label": "压力(MPa)"},
        {"name": "material", "type": "string", "label": "材质"},
        {"name": "seal", "type": "string", "label": "密封"},
        {"name": "price", "type": "number", "label": "价格"}
      ]
    },
    {
      "id": "Customer",
      "label": "客户",
      "table": "valve_customers",
      "key": "id",
      "domain": "销售域",
      "attributes": [
        {"name": "id", "type": "string", "label": "编号", "required": true},
        {"name": "customer_name", "type": "string", "label": "客户名"},
        {"name": "region", "type": "string", "label": "区域"},
        {"name": "industry", "type": "string", "label": "行业"},
        {"name": "credit_level", "type": "enum", "label": "信用等级"}
      ]
    },
    {
      "id": "Sale",
      "label": "销售",
      "table": "valve_sales",
      "key": "id",
      "domain": "销售域",
      "detail": true,
      "attributes": [
        {"name": "id", "type": "string", "label": "编号"},
        {"name": "product_id", "type": "string", "label": "产品", "role": "reference"},
        {"name": "customer_id", "type": "string", "label": "客户", "role": "reference"},
        {"name": "quantity", "type": "number", "label": "数量"},
        {"name": "sale_date", "type": "date", "label": "销售日期"},
        {"name": "amount", "type": "number", "label": "金额"}
      ]
    },
    {
      "id": "Equipment",
      "label": "设备",
      "table": "valve_equipment",
      "key": "id",
      "domain": "生产域",
      "attributes": [
        {"name": "id", "type": "string", "label": "编号", "required": true},
        {"name": "device_name", "type": "string", "label": "设备名"},
        {"name": "device_type", "type": "enum", "label": "设备类型"},
        {"name": "workshop", "type": "string", "label": "车间"},
        {"name": "power_kw", "type": "number", "label": "功率(kW)"},
        {"name": "status", "type": "enum", "label": "状态"}
      ]
    },
    {
      "id": "RawMaterial",
      "label": "原材料",
      "table": "valve_raw_materials",
      "key": "id",
      "domain": "采购域",
      "attributes": [
        {"name": "id", "type": "string", "label": "编号", "required": true},
        {"name": "part_name", "type": "string", "label": "部件名"},
        {"name": "material", "type": "string", "label": "材质"},
        {"name": "supplier", "type": "string", "label": "供应商"},
        {"name": "qc_result", "type": "enum", "label": "质检结果"},
        {"name": "stock", "type": "number", "label": "库存"}
      ]
    },
    {
      "id": "Batch",
      "label": "批次",
      "table": "valve_batches",
      "key": "id",
      "domain": "生产域",
      "attributes": [
        {"name": "id", "type": "string", "label": "编号", "required": true},
        {"name": "product_id", "type": "string", "label": "产品", "role": "reference"},
        {"name": "produce_date", "type": "date", "label": "生产日期"},
        {"name": "quantity", "type": "number", "label": "数量"},
        {"name": "raw_parts", "type": "string", "label": "原料"},
        {"name": "team", "type": "string", "label": "班组"},
        {"name": "status", "type": "enum", "label": "状态"}
      ]
    },
    {
      "id": "BatchIngredient",
      "label": "批次原料",
      "table": "valve_batch_ingredient",
      "key": "batch_id",
      "domain": "生产域",
      "detail": true,
      "attributes": [
        {"name": "batch_id", "type": "string", "label": "批次", "role": "reference"},
        {"name": "raw_id", "type": "string", "label": "原料", "role": "reference"}
      ]
    },
    {
      "id": "Qc",
      "label": "质检",
      "table": "valve_qc",
      "key": "id",
      "domain": "生产域",
      "attributes": [
        {"name": "id", "type": "string", "label": "编号", "required": true},
        {"name": "batch_id", "type": "string", "label": "批次", "role": "reference"},
        {"name": "check_item", "type": "string", "label": "检验项"},
        {"name": "result", "type": "enum", "label": "结果"},
        {"name": "checker", "type": "string", "label": "检验员"},
        {"name": "check_date", "type": "date", "label": "检验日期"}
      ]
    }
  ],
  "relations": [
    {"id": "sells", "from": "Product", "to": "Sale", "fk": "valve_sales.product_id", "cardinality": "1:N", "label": "被销售"},
    {"id": "boughtBy", "from": "Sale", "to": "Customer", "fk": "valve_sales.customer_id", "cardinality": "N:1", "label": "售予客户"},
    {"id": "producedIn", "from": "Batch", "to": "Product", "fk": "valve_batches.product_id", "cardinality": "N:1", "label": "生产产品"},
    {"id": "usesRawMaterial", "from": "BatchIngredient", "to": "RawMaterial", "fk": "valve_batch_ingredient.raw_id", "cardinality": "N:1", "label": "使用原料"},
    {"id": "belongsToBatch", "from": "BatchIngredient", "to": "Batch", "fk": "valve_batch_ingredient.batch_id", "cardinality": "N:1", "label": "属于批次"},
    {"id": "checkedBy", "from": "Qc", "to": "Batch", "fk": "valve_qc.batch_id", "cardinality": "N:1", "label": "质检批次"}
  ],
  "constraints": [
    {"type": "unique", "on": "Product.id", "msg": "产品编号唯一"},
    {"type": "unique", "on": "Customer.id", "msg": "客户编号唯一"},
    {"type": "unique", "on": "Equipment.id", "msg": "设备编号唯一"}
  ]
}
