{
  "version": "1.0",
  "name": "valve-factory-ontology",
  "label": "阀门工厂本体",
  "entities": [
    {
      "id": "Product",
      "label": "产品",
      "table": "valve_products",
      "key": "id",
      "domain": "生产域",
      "attributes": [
        {
          "name": "id",
          "type": "string",
          "label": "编号",
          "required": true
        },
        {
          "name": "model_code",
          "type": "string",
          "label": "型号编码",
          "definition": "产品型号编码, 工厂内部唯一标识产品规格。"
        },
        {
          "name": "product_name",
          "type": "string",
          "label": "产品名"
        },
        {
          "name": "type",
          "type": "enum",
          "label": "阀门类型"
        },
        {
          "name": "size_mm",
          "type": "number",
          "label": "口径(mm)",
          "definition": "阀门公称通径, 单位毫米。"
        },
        {
          "name": "pressure_grade",
          "type": "string",
          "label": "压力等级",
          "definition": "阀门公称压力等级(如 PN16), 决定承压能力。"
        },
        {
          "name": "connection",
          "type": "string",
          "label": "连接形式"
        },
        {
          "name": "seal_material",
          "type": "string",
          "label": "密封面材质"
        },
        {
          "name": "body_material",
          "type": "string",
          "label": "阀体材质"
        },
        {
          "name": "standard_no",
          "type": "string",
          "label": "标准号"
        },
        {
          "name": "temp_range",
          "type": "string",
          "label": "温度范围"
        },
        {
          "name": "price",
          "type": "number",
          "label": "价格"
        }
      ],
      "parent": "BusinessObject",
      "definition": "工厂对外销售/交付的成品阀门及其派生型号, 含口径、压力等级、连接方式、密封与阀体材质等规格。"
    },
    {
      "id": "Customer",
      "label": "客户",
      "table": "valve_customers",
      "key": "id",
      "domain": "销售域",
      "attributes": [
        {
          "name": "id",
          "type": "string",
          "label": "编号",
          "required": true
        },
        {
          "name": "customer_name",
          "type": "string",
          "label": "客户名"
        },
        {
          "name": "region",
          "type": "string",
          "label": "区域"
        },
        {
          "name": "industry",
          "type": "string",
          "label": "行业"
        },
        {
          "name": "credit_level",
          "type": "enum",
          "label": "信用等级",
          "definition": "客户信用等级, 用于销售授信与风险控制。"
        }
      ],
      "parent": "BusinessObject",
      "definition": "采购阀门产品的客户企业, 记录区域、行业归属与信用等级。"
    },
    {
      "id": "Sale",
      "label": "销售",
      "table": "valve_sales",
      "key": "id",
      "domain": "销售域",
      "detail": true,
      "attributes": [
        {
          "name": "id",
          "type": "string",
          "label": "编号"
        },
        {
          "name": "product_id",
          "type": "string",
          "label": "产品",
          "role": "reference"
        },
        {
          "name": "customer_id",
          "type": "string",
          "label": "客户",
          "role": "reference"
        },
        {
          "name": "quantity",
          "type": "number",
          "label": "数量"
        },
        {
          "name": "sale_date",
          "type": "date",
          "label": "销售日期"
        },
        {
          "name": "amount",
          "type": "number",
          "label": "金额"
        }
      ],
      "parent": "BusinessObject",
      "definition": "一次阀门销售记录, 关联产品与客户, 含数量、日期与金额。"
    },
    {
      "id": "Equipment",
      "label": "设备",
      "table": "valve_equipment",
      "key": "id",
      "domain": "生产域",
      "attributes": [
        {
          "name": "id",
          "type": "string",
          "label": "编号",
          "required": true
        },
        {
          "name": "device_name",
          "type": "string",
          "label": "设备名"
        },
        {
          "name": "device_type",
          "type": "enum",
          "label": "设备类型"
        },
        {
          "name": "workshop",
          "type": "string",
          "label": "车间"
        },
        {
          "name": "power_kw",
          "type": "number",
          "label": "功率(kW)",
          "definition": "设备装机功率, 单位千瓦。"
        },
        {
          "name": "status",
          "type": "enum",
          "label": "状态"
        },
        {
          "name": "vibration_mm_s",
          "type": "number",
          "label": "振动(mm/s)",
          "definition": "设备运行振动烈度, 单位 mm/s, 用于状态与故障判定。"
        },
        {
          "name": "temp_c",
          "type": "number",
          "label": "温度(℃)"
        },
        {
          "name": "current_a",
          "type": "number",
          "label": "电流(A)"
        }
      ],
      "parent": "BusinessObject",
      "definition": "生产现场的设备台账, 含设备类型、所属车间、装机功率与运行状态。"
    },
    {
      "id": "RawMaterial",
      "label": "原材料",
      "table": "valve_raw_materials",
      "key": "id",
      "domain": "采购域",
      "attributes": [
        {
          "name": "id",
          "type": "string",
          "label": "编号",
          "required": true
        },
        {
          "name": "part_name",
          "type": "string",
          "label": "部件名"
        },
        {
          "name": "material",
          "type": "string",
          "label": "材质"
        },
        {
          "name": "supplier",
          "type": "string",
          "label": "供应商"
        },
        {
          "name": "qc_result",
          "type": "enum",
          "label": "质检结果"
        },
        {
          "name": "stock",
          "type": "number",
          "label": "库存"
        }
      ],
      "parent": "BusinessObject",
      "definition": "采购入库的原材料/零部件, 含材质、供应商与到货质检结果。"
    },
    {
      "id": "Batch",
      "label": "批次",
      "table": "valve_batches",
      "key": "id",
      "domain": "生产域",
      "attributes": [
        {
          "name": "id",
          "type": "string",
          "label": "编号",
          "required": true
        },
        {
          "name": "product_id",
          "type": "string",
          "label": "产品",
          "role": "reference"
        },
        {
          "name": "produce_date",
          "type": "date",
          "label": "生产日期"
        },
        {
          "name": "quantity",
          "type": "number",
          "label": "数量"
        },
        {
          "name": "raw_parts",
          "type": "string",
          "label": "原料"
        },
        {
          "name": "team",
          "type": "string",
          "label": "班组"
        },
        {
          "name": "status",
          "type": "enum",
          "label": "状态"
        }
      ],
      "parent": "BusinessObject",
      "definition": "一次生产批次, 关联生产的产品、用料、班组与批状态。"
    },
    {
      "id": "BatchIngredient",
      "label": "批次原料",
      "table": "valve_batch_ingredient",
      "key": "batch_id",
      "domain": "生产域",
      "detail": true,
      "attributes": [
        {
          "name": "batch_id",
          "type": "string",
          "label": "批次",
          "role": "reference"
        },
        {
          "name": "raw_id",
          "type": "string",
          "label": "原料",
          "role": "reference"
        }
      ],
      "parent": "BusinessObject",
      "definition": "批次与原材料的多对多配料明细(批次用料构成)。"
    },
    {
      "id": "Qc",
      "label": "质检",
      "table": "valve_qc",
      "key": "id",
      "domain": "生产域",
      "attributes": [
        {
          "name": "id",
          "type": "string",
          "label": "编号",
          "required": true
        },
        {
          "name": "batch_id",
          "type": "string",
          "label": "批次",
          "role": "reference"
        },
        {
          "name": "check_item",
          "type": "string",
          "label": "检验项"
        },
        {
          "name": "press_rule",
          "type": "string",
          "label": "试验压力"
        },
        {
          "name": "hold_sec",
          "type": "number",
          "label": "保压(秒)"
        },
        {
          "name": "leak_bubbles_min",
          "type": "number",
          "label": "泄漏率(泡/min)",
          "definition": "试压时每分钟允许的泄漏气泡数, 为 0 表示零泄漏。"
        },
        {
          "name": "result",
          "type": "enum",
          "label": "结果"
        },
        {
          "name": "checker",
          "type": "string",
          "label": "检验员"
        },
        {
          "name": "check_date",
          "type": "date",
          "label": "检验日期"
        }
      ],
      "parent": "BusinessObject",
      "definition": "批次的质量检验记录, 含检查项目、压力规则、保压时长与泄漏判定结果。"
    }
  ],
  "relations": [
    {
      "id": "sells",
      "from": "Product",
      "to": "Sale",
      "fk": "valve_sales.product_id",
      "cardinality": "1:N",
      "label": "被销售",
      "definition": "Product 与 Sale 的业务关联。"
    },
    {
      "id": "boughtBy",
      "from": "Sale",
      "to": "Customer",
      "fk": "valve_sales.customer_id",
      "cardinality": "N:1",
      "label": "售予客户",
      "definition": "销售记录指向购买该批产品的客户。"
    },
    {
      "id": "producedIn",
      "from": "Batch",
      "to": "Product",
      "fk": "valve_batches.product_id",
      "cardinality": "N:1",
      "label": "生产产品",
      "definition": "生产批次产出哪一个产品。"
    },
    {
      "id": "usesRawMaterial",
      "from": "BatchIngredient",
      "to": "RawMaterial",
      "fk": "valve_batch_ingredient.raw_id",
      "cardinality": "N:1",
      "label": "使用原料",
      "definition": "BatchIngredient 与 RawMaterial 的业务关联。"
    },
    {
      "id": "belongsToBatch",
      "from": "BatchIngredient",
      "to": "Batch",
      "fk": "valve_batch_ingredient.batch_id",
      "cardinality": "N:1",
      "label": "属于批次",
      "definition": "BatchIngredient 与 Batch 的业务关联。"
    },
    {
      "id": "checkedBy",
      "from": "Qc",
      "to": "Batch",
      "fk": "valve_qc.batch_id",
      "cardinality": "N:1",
      "label": "质检批次",
      "definition": "质检记录对应哪一个生产批次。"
    }
  ],
  "constraints": [
    {
      "type": "unique",
      "on": "Product.id",
      "msg": "产品编号唯一"
    },
    {
      "type": "unique",
      "on": "Customer.id",
      "msg": "客户编号唯一"
    },
    {
      "type": "unique",
      "on": "Equipment.id",
      "msg": "设备编号唯一"
    },
    {
      "type": "unique",
      "on": "RawMaterial.id",
      "msg": "原材料编号唯一"
    },
    {
      "type": "in",
      "on": "Product.pressure_grade",
      "values": [
        "PN10",
        "PN16",
        "PN25",
        "PN40"
      ],
      "msg": "压力等级须为 PN10/16/25/40"
    },
    {
      "type": "pattern",
      "on": "Product.model_code",
      "regex": "^[A-Z]{2,4}-?[0-9]{2,6}$",
      "msg": "型号编码格式: 字母+数字"
    },
    {
      "type": "range",
      "on": "Equipment.power_kw",
      "min": 0,
      "max": 5000,
      "msg": "装机功率 0-5000 kW"
    },
    {
      "type": "positive",
      "on": "Sale.quantity",
      "msg": "销售数量不能为负"
    },
    {
      "type": "datatype",
      "on": "Batch.produce_date",
      "value_type": "date",
      "msg": "生产日期须为日期型"
    }
  ],
  "prefix": "fac",
  "version_iri": "https://ontology.example.com/factory/1.0.0"
}