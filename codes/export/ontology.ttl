o:saleDate a owl:DatatypeProperty ;
    rdfs:domain o:Valve_sales ;
    rdfs:range xsd:date ;
    rdfs:label "销售日期"@zh .

o:valveBatchIngredientBatchId a owl:ObjectProperty ;
    rdfs:domain o:ValveBatchIngredient ;
    rdfs:range o:ValveBatches ;
    rdfs:label "所属批次"@zh .

o:valveBatchIngredientRawId a owl:ObjectProperty ;
    rdfs:domain o:ValveBatchIngredient ;
    rdfs:range o:ValveRawMaterials ;
    rdfs:label "使用原料"@zh .

o:valveBatchesProductId a owl:ObjectProperty ;
    rdfs:domain o:ValveBatches ;
    rdfs:range o:ValveProducts ;
    rdfs:label "生产产品"@zh .

o:valveQcBatchId a owl:ObjectProperty ;
    rdfs:domain o:ValveQc ;
    rdfs:range o:ValveBatches ;
    rdfs:label "所属批次"@zh .

o:valveSalesCustomerId a owl:ObjectProperty ;
    rdfs:domain o:ValveSales ;
    rdfs:range o:ValveCustomers ;
    rdfs:label "售予客户"@zh .

o:valveSalesProductId a owl:ObjectProperty ;
    rdfs:domain o:ValveSales ;
