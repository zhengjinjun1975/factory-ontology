o:id a owl:DatatypeProperty ;
    rdfs:domain o:Valve_sales ;
    rdfs:range xsd:string ;
    rdfs:label "编号"@zh .

o:quantity a owl:DatatypeProperty ;
    rdfs:domain o:Valve_sales ;
    rdfs:range xsd:decimal ;
