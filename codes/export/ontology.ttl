o:checkDate a owl:DatatypeProperty ;
    rdfs:domain o:Valve_qc ;
    rdfs:range xsd:date ;
    rdfs:label "检查日期"@zh .

o:checkItem a owl:DatatypeProperty ;
    rdfs:domain o:Valve_qc ;
