# auto-inferred-ontology — OWL 导出（ontology_export.py v0.3.0）
# 源: schema auto-inferred-ontology v1.0

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix o: <https://ontology.example.com/industry/valve#> .

o: a owl:Ontology ;
    rdfs:label "auto-inferred-ontology"@zh ;
    owl:versionIRI <https://ontology.example.com/industry/valve/1.0> .

o:BatchGroup a owl:Class ;
    rdfs:label "BatchGroup"@zh .

o:Production a owl:Class ;
    rdfs:subClassOf o:BatchGroup ;
    rdfs:label "生产域"@zh .

o:Equipment a owl:Class ;
    rdfs:subClassOf o:设备域 ;
    rdfs:label "设备域"@zh .

o:Quality a owl:Class ;
    rdfs:subClassOf o:质量域 ;
    rdfs:label "质量域"@zh .

o:Procurement a owl:Class ;
    rdfs:subClassOf o:采购域 ;
    rdfs:label "采购域"@zh .

o:Sales a owl:Class ;
    rdfs:subClassOf o:销售域 ;
    rdfs:label "销售域"@zh .

o:Valve_batch_ingredient a owl:Class ;
    rdfs:subClassOf o:Production ;
    rdfs:label "批次配料"@zh ;
    skos:definition "生产域中的批次配料，数据来源于 valve_batch_ingredient 表，以 batch_id 唯一标识，记录raw_id等信息；取值样例（原料编号=R005/R007）。"@zh .

o:Valve_batches a owl:Class ;
    rdfs:subClassOf o:Production ;
    rdfs:label "批次"@zh ;
    skos:definition "生产域中的批次，数据来源于 valve_batches 表，以 id 唯一标识，记录product_id、produce_date、quantity、raw_parts、team等信息；取值样例（产品编号=P004/P007；生产日期=2026-07-02/2026-07-03）。"@zh .

o:Valve_customers a owl:Class ;
    rdfs:subClassOf o:Sales ;
    rdfs:label "客户"@zh ;
    skos:definition "销售域中的客户，数据来源于 valve_customers 表，以 id 唯一标识，记录customer_name、region、industry、credit_level等信息；取值样例（客户名称=华北炼化/华东化工集团；区域=华北/华东）。"@zh .

o:Valve_equipment a owl:Class ;
    rdfs:subClassOf o:Equipment ;
    rdfs:label "设备"@zh ;
    skos:definition "设备域中的设备，数据来源于 valve_equipment 表，以 id 唯一标识，记录device_name、device_type、workshop、power_kw、status等信息；取值样例（设备名称=数控车床/立式铣床；设备类型=机加设备/机加设备）。"@zh .

o:Valve_products a owl:Class ;
    rdfs:subClassOf o:Procurement ;
    rdfs:label "产品"@zh ;
    skos:definition "采购域中的产品，数据来源于 valve_products 表，以 id 唯一标识，记录model_code、product_name、type、size_mm、pressure_grade等信息；取值样例（型号代码=Z41H-16C/Z941T-16；产品名称=闸阀 Z41H-16C/电动闸阀 Z941T-16）。"@zh .

o:Valve_qc a owl:Class ;
    rdfs:subClassOf o:Quality ;
    rdfs:label "质检"@zh ;
    skos:definition "质量域中的质检，数据来源于 valve_qc 表，以 id 唯一标识，记录batch_id、check_item、press_rule、hold_sec、leak_bubbles_min等信息；取值样例（批次编号=B007/B003；检查项目=低压密封试验/壳体试验）。"@zh .

o:Valve_raw_materials a owl:Class ;
    rdfs:subClassOf o:Procurement ;
    rdfs:label "原料"@zh ;
    skos:definition "采购域中的原料，数据来源于 valve_raw_materials 表，以 id 唯一标识，记录part_name、material、supplier、qc_result、stock等信息；取值样例（部件名称=阀体铸件/阀体铸件；材质=WCB/CF8）。"@zh .

o:Valve_sales a owl:Class ;
    rdfs:subClassOf o:Sales ;
    rdfs:label "销售"@zh ;
    skos:definition "销售域中的销售，数据来源于 valve_sales 表，以 id 唯一标识，记录product_id、customer_id、quantity、sale_date、amount等信息；取值样例（产品编号=P006/P007；客户编号=C005/C003）。"@zh .

o:id a owl:DatatypeProperty ;
    rdfs:domain o:Valve_batches ;
    rdfs:range xsd:string ;
    rdfs:label "编号"@zh .

o:produceDate a owl:DatatypeProperty ;
    rdfs:domain o:Valve_batches ;
    rdfs:range xsd:date ;
    rdfs:label "生产日期"@zh .

o:quantity a owl:DatatypeProperty ;
    rdfs:domain o:Valve_batches ;
    rdfs:range xsd:decimal ;
    rdfs:label "数量"@zh .

o:rawParts a owl:DatatypeProperty ;
    rdfs:domain o:Valve_batches ;
    rdfs:range xsd:string ;
    rdfs:label "原料"@zh .

o:status a owl:DatatypeProperty ;
    rdfs:domain o:Valve_batches ;
    rdfs:range xsd:string ;
    rdfs:label "状态"@zh .

o:team a owl:DatatypeProperty ;
    rdfs:domain o:Valve_batches ;
    rdfs:range xsd:string ;
    rdfs:label "班组"@zh .

o:creditLevel a owl:DatatypeProperty ;
    rdfs:domain o:Valve_customers ;
    rdfs:range xsd:string ;
    rdfs:label "信用等级"@zh .

o:customerName a owl:DatatypeProperty ;
    rdfs:domain o:Valve_customers ;
    rdfs:range xsd:string ;
    rdfs:label "客户名称"@zh .

o:id a owl:DatatypeProperty ;
    rdfs:domain o:Valve_customers ;
    rdfs:range xsd:string ;
    rdfs:label "编号"@zh .

o:industry a owl:DatatypeProperty ;
    rdfs:domain o:Valve_customers ;
    rdfs:range xsd:string ;
    rdfs:label "行业"@zh .

o:region a owl:DatatypeProperty ;
    rdfs:domain o:Valve_customers ;
    rdfs:range xsd:string ;
    rdfs:label "区域"@zh .

o:currentA a owl:DatatypeProperty ;
    rdfs:domain o:Valve_equipment ;
    rdfs:range xsd:decimal ;
    rdfs:label "电流(A)"@zh .

o:deviceName a owl:DatatypeProperty ;
    rdfs:domain o:Valve_equipment ;
    rdfs:range xsd:string ;
    rdfs:label "设备名称"@zh .

o:deviceType a owl:DatatypeProperty ;
    rdfs:domain o:Valve_equipment ;
    rdfs:range xsd:string ;
    rdfs:label "设备类型"@zh .

o:id a owl:DatatypeProperty ;
    rdfs:domain o:Valve_equipment ;
    rdfs:range xsd:string ;
    rdfs:label "编号"@zh .

o:powerKw a owl:DatatypeProperty ;
    rdfs:domain o:Valve_equipment ;
    rdfs:range xsd:decimal ;
    rdfs:label "功率(kW)"@zh .

o:status a owl:DatatypeProperty ;
    rdfs:domain o:Valve_equipment ;
    rdfs:range xsd:string ;
    rdfs:label "状态"@zh .

o:tempC a owl:DatatypeProperty ;
    rdfs:domain o:Valve_equipment ;
    rdfs:range xsd:decimal ;
    rdfs:label "温度(℃)"@zh .

o:vibrationMmS a owl:DatatypeProperty ;
    rdfs:domain o:Valve_equipment ;
    rdfs:range xsd:decimal ;
    rdfs:label "振动(mm/s)"@zh .

o:workshop a owl:DatatypeProperty ;
    rdfs:domain o:Valve_equipment ;
    rdfs:range xsd:string ;
    rdfs:label "车间"@zh .

o:bodyMaterial a owl:DatatypeProperty ;
    rdfs:domain o:Valve_products ;
    rdfs:range xsd:string ;
    rdfs:label "阀体材质"@zh .

o:connection a owl:DatatypeProperty ;
    rdfs:domain o:Valve_products ;
    rdfs:range xsd:string ;
    rdfs:label "连接方式"@zh .

o:id a owl:DatatypeProperty ;
    rdfs:domain o:Valve_products ;
    rdfs:range xsd:string ;
    rdfs:label "编号"@zh .

o:modelCode a owl:DatatypeProperty ;
    rdfs:domain o:Valve_products ;
    rdfs:range xsd:string ;
    rdfs:label "型号代码"@zh .

o:pressureGrade a owl:DatatypeProperty ;
    rdfs:domain o:Valve_products ;
    rdfs:range xsd:string ;
    rdfs:label "压力等级"@zh .

o:price a owl:DatatypeProperty ;
    rdfs:domain o:Valve_products ;
    rdfs:range xsd:decimal ;
    rdfs:label "价格"@zh .

o:productName a owl:DatatypeProperty ;
    rdfs:domain o:Valve_products ;
    rdfs:range xsd:string ;
    rdfs:label "产品名称"@zh .

o:sealMaterial a owl:DatatypeProperty ;
    rdfs:domain o:Valve_products ;
    rdfs:range xsd:string ;
    rdfs:label "密封材质"@zh .

o:sizeMm a owl:DatatypeProperty ;
    rdfs:domain o:Valve_products ;
