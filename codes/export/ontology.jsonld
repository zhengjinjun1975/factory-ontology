        "@id": "http://factory.example/ontology#Qc"
      },
      "label": "质检批次",
      "range": {
        "@id": "http://factory.example/ontology#Batch"
      }
    },
    {
      "@id": "http://factory.example/ontology#producedIn",
      "@type": "owl:ObjectProperty",
      "definition": "生产批次产出哪一个产品。",
      "domain": {
        "@id": "http://factory.example/ontology#Batch"
      },
      "label": "生产产品",
      "range": {
        "@id": "http://factory.example/ontology#Product"
      }
    },
    {
      "@id": "http://factory.example/ontology#sells",
      "@type": "owl:ObjectProperty",
      "definition": "Product 与 Sale 的业务关联。",
      "domain": {
        "@id": "http://factory.example/ontology#Product"
      },
      "label": "被销售",
      "range": {
        "@id": "http://factory.example/ontology#Sale"
      }
    },
    {
      "@id": "http://factory.example/ontology#usesRawMaterial",
      "@type": "owl:ObjectProperty",
      "definition": "BatchIngredient 与 RawMaterial 的业务关联。",
      "domain": {
        "@id": "http://factory.example/ontology#BatchIngredient"
      },
      "label": "使用原料",
      "range": {
        "@id": "http://factory.example/ontology#RawMaterial"
      }
    }
  ]
}
