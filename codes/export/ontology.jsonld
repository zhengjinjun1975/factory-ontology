        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    },
    {
      "@id": "http://factory.example/ontology#sizeMm",
      "@type": "owl:DatatypeProperty",
      "definition": "阀门公称通径, 单位毫米。",
      "domain": {
        "@id": "http://factory.example/ontology#Valve_products"
      },
      "label": "口径(mm)",
      "range": {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    },
    {
      "@id": "http://factory.example/ontology#standardNo",
