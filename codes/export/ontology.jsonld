      "domain": {
        "@id": "http://factory.example/ontology#Valve_customers"
      },
      "label": "信用等级",
      "range": {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    },
    {
      "@id": "http://factory.example/ontology#customerName",
