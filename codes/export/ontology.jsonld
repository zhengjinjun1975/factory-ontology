{
  "@context": {
    "@vocab": "http://factory.example/ontology#",
    "definition": "skos:definition",
    "domain": "rdfs:domain",
    "label": "rdfs:label",
    "owl": "http://www.w3.org/2002/07/owl#",
    "owl:versionIRI": "http://www.w3.org/2002/07/owl#versionIRI",
    "range": "rdfs:range",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "subClassOf": "rdfs:subClassOf",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@graph": [
    {
      "@id": "http://factory.example/ontology#",
      "@type": "owl:Ontology",
      "label": "阀门工厂本体",
      "owl:versionIRI": {
        "@id": "https://ontology.example.com/factory/1.0.0"
      }
    },
    {
      "@id": "http://factory.example/ontology#Valve_products",
      "@type": "owl:Class",
      "definition": "工厂对外销售/交付的成品阀门及其派生型号, 含口径、压力等级、连接方式、密封与阀体材质等规格。",
      "label": "产品",
      "subClassOf": {
        "@id": "http://factory.example/ontology#BusinessObject"
      }
    },
    {
      "@id": "http://factory.example/ontology#Valve_customers",
      "@type": "owl:Class",
      "definition": "采购阀门产品的客户企业, 记录区域、行业归属与信用等级。",
      "label": "客户",
      "subClassOf": {
        "@id": "http://factory.example/ontology#BusinessObject"
      }
    },
    {
      "@id": "http://factory.example/ontology#Valve_sales",
      "@type": "owl:Class",
      "definition": "一次阀门销售记录, 关联产品与客户, 含数量、日期与金额。",
      "label": "销售",
      "subClassOf": {
        "@id": "http://factory.example/ontology#BusinessObject"
      }
    },
    {
      "@id": "http://factory.example/ontology#Valve_equipment",
      "@type": "owl:Class",
      "definition": "生产现场的设备台账, 含设备类型、所属车间、装机功率与运行状态。",
      "label": "设备",
      "subClassOf": {
        "@id": "http://factory.example/ontology#BusinessObject"
      }
    },
    {
      "@id": "http://factory.example/ontology#Valve_raw_materials",
      "@type": "owl:Class",
      "definition": "采购入库的原材料/零部件, 含材质、供应商与到货质检结果。",
      "label": "原材料",
      "subClassOf": {
        "@id": "http://factory.example/ontology#BusinessObject"
      }
    },
    {
      "@id": "http://factory.example/ontology#Valve_batches",
      "@type": "owl:Class",
      "definition": "一次生产批次, 关联生产的产品、用料、班组与批状态。",
      "label": "批次",
      "subClassOf": {
        "@id": "http://factory.example/ontology#BusinessObject"
      }
    },
    {
      "@id": "http://factory.example/ontology#Valve_batch_ingredient",
      "@type": "owl:Class",
      "definition": "批次与原材料的多对多配料明细(批次用料构成)。",
      "label": "批次原料",
      "subClassOf": {
        "@id": "http://factory.example/ontology#BusinessObject"
      }
    },
    {
      "@id": "http://factory.example/ontology#Valve_qc",
      "@type": "owl:Class",
      "definition": "批次的质量检验记录, 含检查项目、压力规则、保压时长与泄漏判定结果。",
      "label": "质检",
      "subClassOf": {
        "@id": "http://factory.example/ontology#BusinessObject"
      }
    },
    {
      "@id": "http://factory.example/ontology#BusinessObject",
      "@type": "owl:Class",
      "label": "BusinessObject"
    },
    {
      "@id": "http://factory.example/ontology#bodyMaterial",
      "@type": "owl:DatatypeProperty",
      "domain": {
        "@id": "http://factory.example/ontology#Valve_products"
      },
      "label": "阀体材质",
      "range": {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    },
    {
      "@id": "http://factory.example/ontology#connection",
      "@type": "owl:DatatypeProperty",
      "domain": {
        "@id": "http://factory.example/ontology#Valve_products"
      },
      "label": "连接形式",
      "range": {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    },
    {
      "@id": "http://factory.example/ontology#modelCode",
      "@type": "owl:DatatypeProperty",
      "definition": "产品型号编码, 工厂内部唯一标识产品规格。",
      "domain": {
        "@id": "http://factory.example/ontology#Valve_products"
      },
      "label": "型号编码",
      "range": {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    },
    {
      "@id": "http://factory.example/ontology#pressureGrade",
      "@type": "owl:DatatypeProperty",
      "definition": "阀门公称压力等级(如 PN16), 决定承压能力。",
      "domain": {
        "@id": "http://factory.example/ontology#Valve_products"
      },
      "label": "压力等级",
      "range": {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    },
    {
      "@id": "http://factory.example/ontology#price",
      "@type": "owl:DatatypeProperty",
      "domain": {
        "@id": "http://factory.example/ontology#Valve_products"
      },
      "label": "价格",
      "range": {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    },
    {
      "@id": "http://factory.example/ontology#productName",
      "@type": "owl:DatatypeProperty",
      "domain": {
        "@id": "http://factory.example/ontology#Valve_products"
      },
      "label": "产品名",
      "range": {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    },
    {
      "@id": "http://factory.example/ontology#sealMaterial",
