        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    },
    {
      "@id": "http://factory.example/ontology#type",
      "@type": "owl:DatatypeProperty",
      "domain": {
        "@id": "http://factory.example/ontology#Valve_products"
      },
      "label": "阀门类型",
      "range": {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    },
    {
      "@id": "http://factory.example/ontology#creditLevel",
