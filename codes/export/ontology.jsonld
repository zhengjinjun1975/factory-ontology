{
  "@context": {
    "@vocab": "https://ontology.example.com/industry/valve#",
    "definition": "skos:definition",
    "domain": "rdfs:domain",
    "label": "rdfs:label",
    "owl": "http://www.w3.org/2002/07/owl#",
    "owl:versionIRI": "http://www.w3.org/2002/07/owl#versionIRI",
