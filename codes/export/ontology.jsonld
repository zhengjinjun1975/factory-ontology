        "@id": "http://factory.example/ontology#Sale"
      },
      "label": "售予客户",
      "range": {
        "@id": "http://factory.example/ontology#Customer"
      }
    },
    {
      "@id": "http://factory.example/ontology#checkedBy",
      "@type": "owl:ObjectProperty",
