  "@graph": [
    {
      "@id": "https://ontology.example.com/industry/valve#",
      "@type": "owl:Ontology",
      "label": "auto-inferred-ontology",
      "owl:versionIRI": {
        "@id": "https://ontology.example.com/industry/valve/1.0"
      }
    },
    {
      "@id": "https://ontology.example.com/industry/valve#Valve_batch_ingredient",
      "@type": "owl:Class",
      "definition": "生产域中的批次配料，数据来源于 valve_batch_ingredient 表，以 batch_id 唯一标识，记录raw_id等信息；取值样例（原料编号=R005/R007）。",
      "label": "批次配料",
      "subClassOf": {
        "@id": "https://ontology.example.com/industry/valve#BatchGroup"
      }
    },
    {
      "@id": "https://ontology.example.com/industry/valve#Valve_batches",
      "@type": "owl:Class",
      "definition": "生产域中的批次，数据来源于 valve_batches 表，以 id 唯一标识，记录product_id、produce_date、quantity、raw_parts、team等信息；取值样例（产品编号=P004/P007；生产日期=2026-07-02/2026-07-03）。",
      "label": "批次",
      "subClassOf": {
        "@id": "https://ontology.example.com/industry/valve#BatchGroup"
      }
    },
    {
      "@id": "https://ontology.example.com/industry/valve#Valve_customers",
      "@type": "owl:Class",
      "definition": "销售域中的客户，数据来源于 valve_customers 表，以 id 唯一标识，记录customer_name、region、industry、credit_level等信息；取值样例（客户名称=华北炼化/华东化工集团；区域=华北/华东）。",
      "label": "客户",
      "subClassOf": {
        "@id": "https://ontology.example.com/industry/valve#销售域"
      }
    },
    {
      "@id": "https://ontology.example.com/industry/valve#Valve_equipment",
      "@type": "owl:Class",
      "definition": "设备域中的设备，数据来源于 valve_equipment 表，以 id 唯一标识，记录device_name、device_type、workshop、power_kw、status等信息；取值样例（设备名称=数控车床/立式铣床；设备类型=机加设备/机加设备）。",
      "label": "设备",
      "subClassOf": {
        "@id": "https://ontology.example.com/industry/valve#设备域"
      }
    },
    {
      "@id": "https://ontology.example.com/industry/valve#Valve_products",
      "@type": "owl:Class",
      "definition": "采购域中的产品，数据来源于 valve_products 表，以 id 唯一标识，记录model_code、product_name、type、size_mm、pressure_grade等信息；取值样例（型号代码=Z41H-16C/Z941T-16；产品名称=闸阀 Z41H-16C/电动闸阀 Z941T-16）。",
      "label": "产品",
      "subClassOf": {
        "@id": "https://ontology.example.com/industry/valve#采购域"
      }
    },
    {
      "@id": "https://ontology.example.com/industry/valve#Valve_qc",
      "@type": "owl:Class",
      "definition": "质量域中的质检，数据来源于 valve_qc 表，以 id 唯一标识，记录batch_id、check_item、press_rule、hold_sec、leak_bubbles_min等信息；取值样例（批次编号=B007/B003；检查项目=低压密封试验/壳体试验）。",
      "label": "质检",
      "subClassOf": {
        "@id": "https://ontology.example.com/industry/valve#质量域"
      }
    },
    {
      "@id": "https://ontology.example.com/industry/valve#Valve_raw_materials",
      "@type": "owl:Class",
      "definition": "采购域中的原料，数据来源于 valve_raw_materials 表，以 id 唯一标识，记录part_name、material、supplier、qc_result、stock等信息；取值样例（部件名称=阀体铸件/阀体铸件；材质=WCB/CF8）。",
      "label": "原料",
      "subClassOf": {
        "@id": "https://ontology.example.com/industry/valve#采购域"
      }
    },
    {
      "@id": "https://ontology.example.com/industry/valve#Valve_sales",
      "@type": "owl:Class",
      "definition": "销售域中的销售，数据来源于 valve_sales 表，以 id 唯一标识，记录product_id、customer_id、quantity、sale_date、amount等信息；取值样例（产品编号=P006/P007；客户编号=C005/C003）。",
      "label": "销售",
      "subClassOf": {
        "@id": "https://ontology.example.com/industry/valve#销售域"
      }
    },
