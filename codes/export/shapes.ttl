# auto-inferred-ontology — SHACL 约束导出（ontology_export.py v0.3.0）
# constraints 与运行时 validate 同源派生（避免双写漂移）

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix o: <https://ontology.example.com/industry/valve#> .

o:sh_Valve_batch_ingredient_batchId_unique a sh:PropertyShape ;
    sh:path o:batchId ;
    sh:maxCount 1 ;
    sh:message "Valve_batch_ingredient 主键 batch_id 唯一"@zh .

o:sh_Valve_batches_id_unique a sh:PropertyShape ;
    sh:path o:id ;
    sh:maxCount 1 ;
    sh:message "Valve_batches 主键 id 唯一"@zh .

o:sh_Valve_customers_id_unique a sh:PropertyShape ;
    sh:path o:id ;
    sh:maxCount 1 ;
    sh:message "Valve_customers 主键 id 唯一"@zh .

o:sh_Valve_equipment_id_unique a sh:PropertyShape ;
    sh:path o:id ;
    sh:maxCount 1 ;
    sh:message "Valve_equipment 主键 id 唯一"@zh .

o:sh_Valve_products_id_unique a sh:PropertyShape ;
    sh:path o:id ;
    sh:maxCount 1 ;
    sh:message "Valve_products 主键 id 唯一"@zh .

o:sh_Valve_qc_id_unique a sh:PropertyShape ;
    sh:path o:id ;
    sh:maxCount 1 ;
    sh:message "Valve_qc 主键 id 唯一"@zh .

o:sh_Valve_raw_materials_id_unique a sh:PropertyShape ;
    sh:path o:id ;
    sh:maxCount 1 ;
    sh:message "Valve_raw_materials 主键 id 唯一"@zh .

o:sh_Valve_sales_id_unique a sh:PropertyShape ;
    sh:path o:id ;
    sh:maxCount 1 ;
    sh:message "Valve_sales 主键 id 唯一"@zh .

o:Valve_batch_ingredientShape a sh:NodeShape ;
    sh:targetClass o:Valve_batch_ingredient ;
    sh:property o:sh_Valve_batch_ingredient_batchId_unique .

o:Valve_batchesShape a sh:NodeShape ;
    sh:targetClass o:Valve_batches ;
    sh:property o:sh_Valve_batches_id_unique .

o:Valve_customersShape a sh:NodeShape ;
    sh:targetClass o:Valve_customers ;
    sh:property o:sh_Valve_customers_id_unique .

o:Valve_equipmentShape a sh:NodeShape ;
    sh:targetClass o:Valve_equipment ;
    sh:property o:sh_Valve_equipment_id_unique .

o:Valve_productsShape a sh:NodeShape ;
    sh:targetClass o:Valve_products ;
    sh:property o:sh_Valve_products_id_unique .

o:Valve_qcShape a sh:NodeShape ;
    sh:targetClass o:Valve_qc ;
    sh:property o:sh_Valve_qc_id_unique .

o:Valve_raw_materialsShape a sh:NodeShape ;
    sh:targetClass o:Valve_raw_materials ;
    sh:property o:sh_Valve_raw_materials_id_unique .

o:Valve_salesShape a sh:NodeShape ;
    sh:targetClass o:Valve_sales ;
    sh:property o:sh_Valve_sales_id_unique .

